{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "casanaura/azuriom-seeker",
    "type": "azuriom-plugin",
    "description": "A talent portal for freelance commissions and project opportunities.",
    "autoload": {
        "psr-4": {
            "Azuriom\\Plugin\\Seeker\\": "src/"
        }
    },
    "replace": {
        "guzzlehttp/guzzle": "*",
        "guzzlehttp/promises": "*",
        "guzzlehttp/psr7": "*",
        "monolog/monolog": "*",
        "nesbot/carbon": "*",
        "psr/container": "*",
        "psr/event-dispatcher": "*",
        "psr/http-client": "*",
        "psr/http-factory": "*",
        "psr/http-message": "*",
        "psr/log": "*",
        "psr/simple-cache": "*"
    }
}
